# ─────────────────────────────────────────────────────────────────────────────
# scripts/.env.example — environment reference for the scripts under scripts/
#
# Lookup path
# ────────────
# This file lives in `scripts/`, and it is the example file for the scripts in
# this directory:
#
#   * `scripts/smoke-config.ts` reads THIS file (`scripts/.env.example`) and
#     validates it against the Zod schema in `scripts/config.ts`.
#   * `scripts/validate-config.ts` looks for a real environment file in this
#     order:
#         1. scripts/.env.local
#         2. scripts/.env
#         3. <repo root>/.env.local
#         4. <repo root>/.env
#     If none exists it falls back to `scripts/.env.example` and says so.
#   * Every other script reads `process.env` directly, so the variables must be
#     exported in the shell (or exported from one of the files above).
#
# The repository-root `.env.example` documents the frontend/root tooling
# variables only; the variables the scripts need are documented here.
#
# Secret handling
# ───────────────
# Every variable marked "secret" below is registered in
# `scripts/logger.ts` (SECRET_ENV_VARS). The logger masks secret material in
# every message it writes, so a key that reaches a log line is masked before
# it is emitted. Any variable whose name ends in `_SECRET`, `_SECRET_KEY`, or
# `_PRIVATE_KEY` is treated as secret automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Deployed FlowPay contract ID (starts with C, 56 characters).
# The value below is a well-formed PLACEHOLDER so that the example file can be
# validated by `npx tsx smoke-config.ts` / `npx tsx validate-config.ts`.
# Replace it with your own deployed contract ID.
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# Stellar secret key for the keeper account (starts with S, 56 characters)
# This account pays transaction fees. Fund it with at least 10 XLM.
# Canonical name is SECRET_KEY; KEEPER_SECRET is a deprecated alias.
# The value below is a well-formed PLACEHOLDER that funds nothing and cannot
# sign anything — replace it with a real key before running the keeper live.
# SECRET: never logged — the logger masks it.
SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEXAMPLE

# Stellar public key for the keeper account (starts with G, 56 characters)
# Required by keeper even in dry-run mode.
KEEPER_PUBLIC_KEY=

# Deprecated alias for SECRET_KEY (will be removed in a future release).
# KEPPER_SECRET=

# ── Network ───────────────────────────────────────────────────────────────────

# Soroban RPC endpoint
# Testnet (default): https://soroban-testnet.stellar.org
# Mainnet:           https://soroban-mainnet.stellar.org  (or your own node)
# Note: For failover, you can use RPC_URLS with a comma-separated list of URLs instead.
RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated list of RPC endpoints, tried in order on failover.
# Used by scripts/rpc-client.ts. Defaults to RPC_URL when unset.
RPC_URLS=https://soroban-testnet.stellar.org,https://rpc-testnet.stellar.org

# Stellar network passphrase
# Testnet (default): Test SDF Network ; September 2015
# Mainnet:           Public Global Stellar Network ; September 2015
# Canonical name is NETWORK_PASSPHRASE; NETWORK_PASSTHRASE is a deprecated typo alias.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deprecated typo alias for NETWORK_PASSPHRASE (will be removed in a future release).
# NETWORK_PASSTHRASE=

# Mainnet safety gate: must be "true" to run the keeper with the mainnet
# passphrase above. Any other value blocks startup.
ALLOW_MAINNET=false
# "mainnet" switches health-check.ts to the public network passphrase.
# Any other value (or unset) means testnet.
# NETWORK=testnet

# Frontend-style fallbacks. Several scripts accept VITE_* names so they can be
# pointed at a frontend .env without a second copy of the values.
# VITE_CONTRACT_ID=
# VITE_RPC_URL=
# VITE_NETWORK_PASSPHRASE=
# Native XLM SAC on testnet (testnet-setup.ts).
# VITE_DEFAULT_TOKEN=

# ── Keeper tuning ─────────────────────────────────────────────────────────────

# Set to "true" to run in dry-run simulation mode (no transactions submitted)
DRY_RUN=false

# Subscribers per batch_charge call (default: 50, max: 200).
# The hard maximum of 200 mirrors the contract's MAX_BATCH_SIZE_CEILING —
# see contract/src/caps.rs (and the operator-facing table in docs/limits.md).
# The keeper additionally clamps this value to the live on-chain max reported
# by get_max_batch_size(), which defaults to 50.
BATCH_SIZE=50

# Seconds between full charge cycles (default: 3600 = 1 hour)
INTERVAL_SECONDS=3600

# Use legacy sequential paging instead of grace-urgency-ordered batches
KEEPER_USE_LEGACY_PAGING=false

# Directory where the keeper writes dry-run reports and the live-cycle pointer
# file (default: <scripts>/data/benchmarks)
# REPORT_DIR=data/benchmarks

# Batch-size override used by scripts/batch-optimizer.ts. Unset means "ask the
# contract", falling back to 50. Always clamped to the contract ceiling of 200.
# MAX_BATCH_SIZE=50

# Maximum number of ready subscribers scheduled in one cycle by
# scripts/batch-optimizer.ts. Unset means "no cycle cap".
# MAX_CYCLE_USERS=200

# Subscriber page size used by scripts/batch-optimizer.ts and
# scripts/subscriber-health-dashboard.ts (default: 50, max: 50).
# PAGE_SIZE=50

# ── Indexer ───────────────────────────────────────────────────────────────────

# Directory for the SQLite database file (default: data)
# In Docker, this is mounted to /app/data via the shared volume.
DATA_DIR=data

# Full path override for the SQLite database file (optional)
# DB_FILE=data/events.db

# Path of the indexer database as used by the reporting scripts.
# Defaults to <DATA_DIR>/events.db.
# INDEXER_DB_PATH=data/events.db

# Alternative indexer database path used by alert-failed-charges.ts and
# churn-analysis.ts (default: indexer.db)
# INDEXER_DB=indexer.db

# Polling interval in milliseconds for fetching events from RPC (default: 10000)
POLL_INTERVAL_MS=10000

# Ledger to start from on first run (optional, default: latest)
# Useful for backfilling historical events.
START_LEDGER=

# Time-to-live in milliseconds for the event deduplication cache
# (default: 0, i.e. the cache entry never expires on its own)
EVENT_DEDUP_TTL_MS=0

# Maximum number of entries kept in the event deduplication cache
# (default: 10000)
# EVENT_DEDUP_CACHE_SIZE=10000

# Directory the indexer database is copied to by scripts/backup-indexer-db.ts
# (default: data/backups)
# BACKUP_DIR=data/backups

# ── Metrics server ───────────────────────────────────────────────────────────

# HTTP port for the Prometheus /metrics endpoint (default: 9090)
METRICS_PORT=9090

# ── Observability ─────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error (default: info)
# Use "debug" for local development; "info" or "warn" in production.
LOG_LEVEL=info

# Set to "json" to emit JSON lines instead of human-readable text.
# LOG_FORMAT=json

# Set to "1" (or to a string containing "payflow") for verbose watch-events
# output.
# DEBUG=1

# Show progress output in scripts/subscriber-health-dashboard.ts.
# Any value other than "0" enables it.
# PROGRESS=1

# ── Webhooks ──────────────────────────────────────────────────────────────────

# Optional URL to send signed event notifications.
# WEBHOOK_URL=

# Required if WEBHOOK_URL is set. Used to generate HMAC-SHA256 signature
# which is sent in the X-PayFlow-Signature header on the exact request body.
# SECRET: never logged — the logger masks it.
# WEBHOOK_SECRET=

# Where to log permanently failed webhook deliveries (after transient retries).
WEBHOOK_DLQ_FILE=data/webhook-dlq.jsonl

# Webhook target used by scripts/grace-period-monitor.ts when WEBHOOK_URL is
# not set.
# ALERT_WEBHOOK_URL=

# Webhook target used by scripts/onboard-merchant.ts to report onboarding
# results.
# MERCHANT_ONBOARD_WEBHOOK_URL=

# Webhook target used by scripts/daily-revenue-summary.ts to post the daily
# revenue summary to Slack.
# SLACK_WEBHOOK_URL=

# Friendbot endpoint used by scripts/testnet-setup.ts to fund test accounts.
FRIENDBOT_URL=https://friendbot.stellar.org

# ── Allowance and expiry checks ───────────────────────────────────────────────

# How far ahead (in ledgers) an expiring allowance is reported as expiring
# (default: 17280 ≈ 24 h)
ALERT_WINDOW_LEDGERS=17280

# Number of addresses checked in parallel (default: 5)
CONCURRENCY=5

# Retry attempts for a failed allowance check (default: 3)
MAX_RETRIES=3

# Base delay in milliseconds between retries (default: 300)
RETRY_BASE_MS=300

# TTL (in ledgers) below which a subscription's storage entry is considered
# expiring (default: 500000)
EXPIRING_TTL_LEDGERS=500000

# Number of ledger entries read per page by the subscriber health dashboard
# (default: 100)
LEDGER_ENTRY_BATCH=100

# ── Allowance top-up (scripts/topup-allowance.ts) ────────────────────────────

# SAC token contract address whose allowance is topped up.
# TOKEN_ADDRESS=

# Subscriber G-address whose allowance is topped up.
# USER_ADDRESS=

# Subscriber secret key used to sign the approve() transaction
# (required unless --simulate).
# SECRET: never logged — the logger masks it.
# USER_SECRET=

# Allowance amount in stroops, as a decimal integer string (100 XLM = 1000000000).
# AMOUNT=1000000000

# Ledgers the new allowance stays valid for (default: 17280 ≈ 24 h).
# EXPIRY_LEDGERS=17280

# ── Grace period monitor (scripts/grace-period-monitor.ts) ───────────────────

# Percentage of subscriptions that must be inside the grace window before an
# alert is raised (default: 25)
GRACE_ALERT_THRESHOLD_PCT=25

# File the keeper writes its heartbeat into. The monitor reads it to decide
# whether the keeper is alive.
# Default: <scripts>/data/keeper-heartbeat.json
# KEEPER_HEARTBEAT_PATH=data/keeper-heartbeat.json

# ── DLQ replay (scripts/replay-dlq.ts) ───────────────────────────────────────

# Path to the dead-letter queue written by the keeper
# (default: dlq/failed-batches.jsonl)
# DLQ_FILE=dlq/failed-batches.jsonl

# Retry attempts per DLQ entry (default: 3)
KEEPER_MAX_RETRIES=3

# Base delay in milliseconds between DLQ retries (default: 1000)
KEEPER_RETRY_BASE_MS=1000

# ── Deployment and admin ──────────────────────────────────────────────────────

# Secret key used by admin-signed operations — soroban-admin.ts and
# onboard-merchant.ts.
# SECRET: never logged — the logger masks it.
# ADMIN_SECRET_KEY=

# Secret key used by the keeper benchmark in real (non-simulation) mode.
# Falls back to SECRET_KEY when unset.
# SECRET: never logged — the logger masks it.
# KEEPER_SECRET_KEY=

# Stellar account used as the transaction source for read-only queries and
# deployment dry runs (deploy-pipeline.ts, pre-upgrade-check.ts,
# top-merchants.ts). Defaults to a zero-funded testnet account.
# SOROBAN_SOURCE_ACCOUNT=

# ── Health check (scripts/health-check.ts) ───────────────────────────────────

# Set to "true" to run the deep health checks (extra RPC round-trips).
# HEALTH_DEEP=false
