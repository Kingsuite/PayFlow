# Root .env.example — environment variables for the repository-root tooling.
#
# Lookup path
# ────────────
#   * The scripts under `scripts/` read their configuration from
#     `scripts/.env.example` (see that file for the full list of variables
#     the scripts use). `scripts/validate-config.ts` looks for
#     `scripts/.env.local`, then `scripts/.env`, then this directory's
#     `.env.local` / `.env`, and finally falls back to `scripts/.env.example`.
#   * The variables below are the ones used by the repository-root tooling
#     (the root `keeper.ts` / `keeper-config.ts` stubs and the frontend's
#     Vite configuration).
#
# Secret handling
# ───────────────
# Every secret below is registered in `scripts/logger.ts` (SECRET_ENV_VARS),
# so the shared logger masks it before it reaches a log line, a CI job log, or
# an alerting webhook.

# Keeper secret key (required). You can generate one with `stellar-sdk Keypair.random()`.
# Canonical name is SECRET_KEY; KEEPER_SECRET is the deprecated alias that the
# root keeper-config.ts still reads.
SECRET_KEY=

# Deprecated: use SECRET_KEY instead (kept for backwards compatibility)
# KEEPER_SECRET=

# Optional public key. If set, the keeper will verify it matches SECRET_KEY.
KEEPER_PUBLIC_KEY=

# Network passphrase. Defaults to the Stellar testnet.
# For mainnet, set to: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=

# Deprecated: use NETWORK_PASSPHRASE instead (kept for backwards compatibility)
# NETWORK_PASSTHRASE=

# Must be "true" when using the mainnet passphrase.
ALLOW_MAINNET=false
